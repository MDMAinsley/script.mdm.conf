<settings>
  <category label="Build storage">
    <setting id="storage_provider" type="select" label="Storage service" values="Koofr|Custom WebDAV" default="Koofr" />
    <setting id="storage_endpoint" type="text" label="Custom HTTPS WebDAV address" default="" />
    <setting id="storage_username" type="text" label="Storage email / username" default="" option="hidden" />
    <setting id="storage_password" type="text" label="WebDAV application password (not account password)" default="" option="hidden" />
  </category>
<category label="Device tuning"><setting id="device_profile" type="select" label="Profile" default="Recommended" values="Recommended|Low memory|Balanced" /><setting id="device_quality_max" type="select" label="Maximum quality" default="Suggested" values="Suggested|Unlimited|720p|1080p|4K" /><setting id="device_unknown_quality" type="select" label="Unknown source quality" default="Show" values="Show|Hide" /></category>
<category label="Connection / file size"><setting id="device_connection_mbps" type="text" label="Connection speed Mbps (0 = off; max 10000)" default="0" /><setting id="device_max_size_gib" type="text" label="Maximum reported size GiB (0 = unlimited; max 10000)" default="0" /><setting id="device_source_order" type="select" label="Source order" default="Quality" values="Quality|Connection|Smallest" /><setting id="device_unknown_size" type="select" label="Unknown size when size limit is active" default="Show" values="Show|Hide" /><setting id="device_slow_sources" type="select" label="Above estimated connection budget" default="Show" values="Show|Hide" /><setting id="device_unknown_bitrate" type="select" label="Unknown bitrate when connection is active" default="Show" values="Show|Hide" /></category>
</settings>
