<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.mdm.conf"
	   name="MDM Conf" 
	   version="0.2.0"
	   provider-name="MDMAinsley">
	   
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  
  <extension point="xbmc.python.script" library="default.py"/>
  
  <extension point="xbmc.addon.metadata">
    <summary>MDM setup and configuration hub</summary>
    <description>Setup hub with portable configuration builds, Koofr/WebDAV upload and download, validated previews and recoverable restore.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
  
</addon>
